#: ../plugin.py:136
msgid "Select FM band range by region. \"Russia\" provides 64-108 MHz (full FM band), \"Europe/World\" 87.5-108 MHz, \"Japan\" 76-95 MHz, \"China\" 76-108 MHz and \"America\" 88.1-107.9 MHz."
msgstr "Επιλέξτε το εύρος της μπάντας FM με βάση την περιοχή. Η \"Ρωσία\" παρέχει 64-108 MHz (πλήρης μπάντα FM), η \"Ευρώπη/Κόσμος\" 87.5-108 MHz, η \"Ιαπωνία\" 76-95 MHz, η \"Κίνα\" 76-108 MHz και η \"Αμερική\" 88.1-107.9 MHz."

#: ../plugin.py:102
msgid "Select the tuning mode for analog modulations. \"simple\" is designed for listening to radio stations, as it applies band limits and allows only rough frequency changes. \"advanced\" disables limits and allows precise control over frequency selection."
msgstr "Επιλέξτε τη λειτουργία συντονισμού για τις αναλογικές διαμορφώσεις. Η 'απλή' είναι σχεδιασμένη για ακρόαση σταθμών, καθώς περιορίζει τις ραδιοφωνικές μπάντες και επιτρέπει χοντρικές αλλαγές στη συχνότητα. Η 'προηγμένη' απενεργοποιεί τα όρια και επιτρέπει ακριβή έλεγχο της συχνότητας."

#: ../plugin.py:623
#, python-format
msgid "Selected frequency successfuly stored to memory preset %d."
msgstr "Η επιλεγμένη συχνότητα αποθηκεύτηκε στη μνήμη %d με επιτυχία."

#: ../plugin.py:124
msgid "Set the frequency bandwidth for FM band. For RDS set to 171 (default = 171k)."
msgstr "Ορίστε το εύρος ζώνης για την μπάντα FM. Για λειτουργία με RDS επιλέξτε 171 (προεπιλογή = 171k)."

#: ../plugin.py:132
msgid "Set the frequency bandwidth for LSB and USB bands (default = 5k)."
msgstr "Ορίστε το εύρος ζώνης για την μπάντα LSB και USB (προεπιλογή = 5k)."

#: ../plugin.py:128
msgid "Set the frequency bandwidth for NFM and AM bands (default = 20k)."
msgstr "Ορίστε το εύρος ζώνης για την μπάντα NFM και AM (προεπιλογή = 20k)."

#: ../plugin.py:120
msgid "Set the tuner gain value for AM, NFM, LSB, and USB (default = auto)."
msgstr "Ορίστε το κέρδος δέκτη για την μπάντα FM, LSB και USB (προεπιλογή = αυτόματα)."

#: ../plugin.py:116
msgid "Set the tuner gain value for DAB/DAB+ (default = auto)."
msgstr "Ορίστε το κέρδος δέκτη για την μπάντα DAB/DAB+ (προεπιλογή = αυτόματα)."

#: ../plugin.py:112
msgid "Set the tuner gain value for FM band (default = auto)."
msgstr "Ορίστε το κέρδος δέκτη για την μπάντα FM (προεπιλογή = αυτόματα)."

